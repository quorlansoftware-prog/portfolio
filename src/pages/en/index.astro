---
import PortfolioCatalog from '../../components/PortfolioCatalog.astro';
import siteConfig from '../../content/site.json';

const source = siteConfig.site.catalog;
const catalog = { ...source, ...(source.translations?.en ?? {}) };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={catalog.description} />
    <title>{catalog.title} · Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <PortfolioCatalog locale="en" />
  </body>
</html>
